{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qualia",
  "version": "0.1.0",
  "identifier": "com.okeymeta.qualia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "qualia",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwMzVENDdENTVFNURBMUMKUldRYzJ1VlZmZFExOEl6bGlYT2NHWW9rdFZPR1gwREFDeld0dEVkQVBhRGhUanA5ZVNZUFcwbHIK",
      "endpoints": [
        "https://github.com/okeymeta/qualia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
